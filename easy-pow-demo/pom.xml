<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <packaging>jar</packaging>

  <parent>
    <groupId>io.github.lucky845</groupId>
    <artifactId>easy-pow</artifactId>
    <version>0.1.4</version>
  </parent>

  <artifactId>easy-pow-demo</artifactId>

  <name>${project.artifactId}</name>
  <description>PoW 演示应用(altcha 前端联调入口)</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- demo 不进发布链:不产 sources/javadoc,Central 上传侧再由父 pom excludeArtifacts 兜底排除 -->
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.lucky845</groupId>
      <artifactId>easy-pow-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 演示 /actuator/metrics:端到端联调时观察 PoW 指标(依赖已由 Boot BOM 管理版本) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${maven.spring.boot.plugin.version}</version>
        <configuration>
          <mainClass>io.github.lucky845.basic.pow.demo.PowDemoApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!--
    发布链:父 pom 的 release profile 会把 central-publishing-maven-plugin 注入每个模块,
    demo 虽已 maven.deploy.skip + 父 pom excludeArtifacts 排除,插件仍会空跑一次 publish 并等待 Portal 结果。
    这里用同名 profile 显式 skipPublishing,让"demo 不进发布链"名副其实。
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.publishing.plugin.version}</version>
            <configuration>
              <skipPublishing>true</skipPublishing>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
