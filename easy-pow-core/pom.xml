<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <packaging>jar</packaging>

  <parent>
    <groupId>io.github.lucky845</groupId>
    <artifactId>easy-pow</artifactId>
    <version>0.1.5</version>
  </parent>

  <artifactId>easy-pow-core</artifactId>

  <name>${project.artifactId}</name>
  <description>PoW 核心模块,无框架依赖</description>

  <!-- 设计红线:compile scope 零第三方依赖;slf4j-api 为 provided(不传递到使用方),
       测试期另挂 slf4j-nop 抑制 "No SLF4J providers were found"(版本由 spring-boot-dependencies 管理) -->
  <dependencies>
    <!-- 用 provided 而非 compile:切换主存储会改变校验语义(CLOSED 下全部校验失败),必须留痕,
         但 Spring Boot 应用本来就带 slf4j;纯 Java 用户不引日志门面也不会因缺类而崩。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
